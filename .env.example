# Database Configuration (SIGLS - Destino - MySQL)
# Use credenciais separadas para evitar problemas com caracteres especiais na senha
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="sigls_db"
DB_USER="root"
DB_PASSWORD="senha"

# Source Database Configuration (Base da Saúde - Fonte - PostgreSQL)
SOURCE_DB_HOST="localhost"
SOURCE_DB_PORT="5432"
SOURCE_DB_NAME="base_saude"
SOURCE_DB_USER="usuario"
SOURCE_DB_PASSWORD="senha"

# JWT Configuration
# IMPORTANTE: Gere um secret único em produção com:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# API Configuration
API_PORT=8008
NODE_ENV="development"

# Rate Limiting
# Teto de requisições por IP a cada 15 min nas rotas públicas do mapa.
RATE_LIMIT_PUBLIC_MAX=1000
# Teto de eventos de analytics por IP a cada 1 min.
RATE_LIMIT_ANALYTICS_MAX=300
# IPs/faixas isentos de rate limit, separados por vírgula (aceita CIDR).
# As faixas privadas (10/8, 172.16/12, 192.168/16, 127/8) já são isentas por padrão.
# Preencha aqui quando uma rede interna sair por um IP PÚBLICO de NAT — sem isso,
# todos os usuários dessa rede dividem uma única cota e o limite estoura em minutos.
# Ex.: RATE_LIMIT_WHITELIST=200.100.50.10,45.4.16.0/22
RATE_LIMIT_WHITELIST=

# ETL Worker Configuration
ETL_SCHEDULE_CRON="0 2 * * *"  # Runs daily at 2 AM
ETL_BATCH_SIZE=1000

# Frontend Configuration
VITE_API_URL="http://localhost:8008"

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/app.log"
